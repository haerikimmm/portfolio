---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Haeri Kim — UX Designer & Researcher" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Boldonse&family=Stack&display=swap" rel="stylesheet">
		<title>{title}</title>
		<script is:inline>
			// Runs before first paint so the page never flashes the wrong theme.
			(function () {
				var stored = null;
				try { stored = localStorage.getItem('theme'); } catch (e) {}
				var dark = stored
					? stored === 'dark'
					: window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
<style is:global>
	:root {
		color-scheme: light;

		--color-bg: #E3E3E3;
		--color-dark: #1A1A1A;
		--color-text: #1A1A1A;
		--color-text-secondary: #555555;
		--color-text-muted: #999999;
		--color-text-faint: #CCCCCC;
		--color-text-title: #333333;
		--color-text-desc: #888888;
		--color-badge-text: #BBBBBB;
		--color-border: #D9D3CC;
		--color-border-subtle: #DDDDDD;
		--color-divider: #EBEBEB;
		--color-surface: #EDE8E3;
		--color-white: #FFFFFF;

		--color-card: #FFFFFF;
		--color-card-muted: #F5F5F5;
		--color-thumb: #E8E8E8;
		--color-shadow: rgba(0, 0, 0, 0.1);

		--color-accent-red: #FF5B2C;
		--color-accent-blue: #86B3FF;
		--color-accent-yellow: #FFBD69;
		--color-accent-cyan: #00BFFF;
		--color-on-accent: #FFFFFF;

		--color-selection-bg: #D6F4FF;
		--color-selection-text: #1A1A1A;

		/* Kept as a real filter (not `none`) so it composes in shorthand lists */
		--media-dim: brightness(1);

		--font: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		--font-body: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		--font-serif: 'Stack', 'Helvetica Neue', Helvetica, Arial, sans-serif;
		--container-width: 1000px;
	}

	:root[data-theme="dark"] {
		color-scheme: dark;

		--color-bg: #121212;
		--color-dark: #000000;
		--color-text: #EDEDED;
		--color-text-secondary: #A8A8A8;
		--color-text-muted: #7C7C7C;
		--color-text-faint: #5A5A5A;
		--color-text-title: #E8E8E8;
		--color-text-desc: #8C8C8C;
		--color-badge-text: #6E6E6E;
		--color-border: #353535;
		--color-border-subtle: #3A3A3A;
		--color-divider: #2A2A2A;
		--color-surface: #262626;
		--color-white: #1C1C1C;

		--color-card: #1C1C1C;
		--color-card-muted: #242424;
		--color-thumb: #2E2E2E;
		--color-shadow: rgba(0, 0, 0, 0.5);

		--color-accent-red: #FF7A54;
		--color-accent-blue: #86B3FF;
		--color-accent-yellow: #FFBD69;
		--color-accent-cyan: #0EA5D9;
		--color-on-accent: #FFFFFF;

		--color-selection-bg: #1F4657;
		--color-selection-text: #EDEDED;

		/* Take the edge off bright photos on a dark page */
		--media-dim: brightness(0.86) contrast(1.02);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		font-family: var(--font-body);
		background: var(--color-bg);
		color: var(--color-text);
		scroll-behavior: smooth;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		transition: background-color 0.25s ease, color 0.25s ease;
	}

	body {
		min-height: 100vh;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font);
		font-weight: 700;
		line-height: 1.2;
		color: var(--color-text);
		letter-spacing: -0.03em;
	}

	p {
		font-family: var(--font-body);
		font-weight: 400;
		line-height: 1.7;
		color: var(--color-text-secondary);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	::selection {
		background-color: var(--color-selection-bg);
		color: var(--color-selection-text);
	}

	img, video {
		filter: var(--media-dim);
	}

	.container {
		max-width: var(--container-width);
		margin: 0 auto;
		padding: 0 2rem;
		width: 100%;
	}

	@media (max-width: 768px) {
		.container {
			padding: 0 1.5rem;
		}
	}

	/* Project pages - smaller text */
	.project-page .description {
		font-size: 0.9rem;
	}

	.project-page .project-info h1 {
		font-size: 1.75rem;
	}

	.project-page .project-description,
	.project-page p {
		font-size: 0.88rem;
		line-height: 1.65;
	}

	.project-page .meta-value {
		font-size: 0.82rem;
	}

	/* Page load fade + slide up */
	body {
		opacity: 0;
		transform: translateY(18px);
		transition: opacity 0.9s ease, transform 0.9s ease;
	}

	body.loaded {
		opacity: 1;
		transform: translateY(0);
	}

	/* Scroll animations */
	.reveal {
		opacity: 0;
		transform: translateY(20px);
		transition: opacity 0.8s ease, transform 0.8s ease;
	}

	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<script>
	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('visible');
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.05 });

	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
		requestAnimationFrame(() => document.body.classList.add('loaded'));
	});
</script>
