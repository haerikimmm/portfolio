---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Journi | Haeri Kim">
	<Nav />
	<main class="project-page">
		<div class="container">
			<div class="project-info reveal">
				<h1>Journi</h1>
				<p class="description">A travel journaling web app inspired by coloring maps, making it easy to record and revisit your trips in one place.</p>
			</div>
			<div class="meta-grid reveal">
				<div class="meta-item"><span class="meta-label">Course</span><span class="meta-value">Software Prototyping 2026</span></div>
				<div class="meta-item"><span class="meta-label">Team</span><span class="meta-value">Haeri Kim, Tomas Horsky</span></div>
				<div class="meta-item"><span class="meta-label">Tech</span><span class="meta-value">Svelte, JavaScript, D3.js</span></div>
			</div>
			<div class="project-content reveal">
				<div class="video-wrapper">
					<video controls preload="metadata">
						<source src="/portfolio/images/courses/jouni-demo.mp4" type="video/mp4" />
					</video>
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.project-page { padding-top: 7rem; padding-bottom: 4rem; }
	.project-info { margin-bottom: 3rem; }
	.project-info h1 { font-family: var(--font); font-size: 2.5rem; font-weight: 700; color: var(--color-text); letter-spacing: -0.03em; margin-bottom: 0.75rem; }
	.description { font-size: 1.1rem; color: var(--color-text-secondary); line-height: 1.6; }
	.meta-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background-color: var(--color-border); border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden; margin-bottom: 3rem; }
	.meta-item { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.5rem; background-color: var(--color-bg); }
	.meta-label { font-family: var(--font); font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
	.meta-value { font-family: var(--font-body); font-size: 0.95rem; color: var(--color-text); font-weight: 500; }
	.project-content { display: flex; flex-direction: column; gap: 2rem; }
	.video-wrapper { width: 100%; border-radius: 12px; overflow: hidden; }
	.video-wrapper video { width: 100%; height: auto; display: block; border-radius: 12px; }
	@media (max-width: 768px) { .project-info h1 { font-size: 1.75rem; } .meta-grid { grid-template-columns: 1fr; } }
</style>
