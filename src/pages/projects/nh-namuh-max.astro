---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

// Animated walkthrough built from the Figma prototype frames (public/nh-showcase).
const showcaseUrl = '/portfolio/nh-showcase/index.html';
---

<Layout title="NH namuh Max | Haeri Kim">
	<Nav />
	<main class="project-page">
		<div class="container">
			<div class="project-info reveal">
				<h1>NH namuh Max</h1>
				<p class="description">Progressive Onboarding: AI Interaction Design for Exploring a Desktop Trading System</p>
			</div>
			<div class="meta-grid reveal">
				<div class="meta-item"><span class="meta-label">Client</span><span class="meta-value">NH Investment &amp; Securities</span></div>
				<div class="meta-item"><span class="meta-label">Team</span><span class="meta-value">2 (User Research, UI Prototyping)</span></div>
				<div class="meta-item"><span class="meta-label">Year</span><span class="meta-value">Apr–Aug 2026</span></div>
				<div class="meta-item"><span class="meta-label">Work Scope</span><span class="meta-value">AI Interaction</span></div>
			</div>
			<div class="project-content reveal">
				<p class="project-description">We designed progressive onboarding for namuh Max, NH Investment &amp; Securities’ desktop web trading system (WTS). Dense, multi-panel screens overwhelm people used to mobile trading apps, and one-time tours cannot help when users get stuck. Through a workshop with 7 participants and a user study with 10, we found that people welcomed AI support during exploration but wanted to request more detail at their own pace. Our proposal, the “anchored accordion,” places an AI help indicator beside the relevant area and expands details only as far as users choose, keeping support contextual and user-controlled.</p>

				<h3 class="section-title">UI Walkthrough</h3>
				<div class="showcase-embed">
					<iframe src={showcaseUrl} title="namuh Max prototype walkthrough" loading="lazy"></iframe>
				</div>
				<p class="embed-note">
					Click a chapter bar to jump, use ← → to step, space to pause. <a href={showcaseUrl} target="_blank" rel="noopener">Open full screen ↗</a>
				</p>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	.project-page { padding-top: 7rem; padding-bottom: 4rem; }
	.project-info { margin-bottom: 3rem; }
	.project-info h1 { font-family: var(--font); font-size: 2.5rem; font-weight: 700; color: var(--color-text); letter-spacing: -0.03em; margin-bottom: 0.75rem; }
	.description { font-size: 1.1rem; color: var(--color-text-secondary); line-height: 1.6; }
	.meta-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background-color: var(--color-border); border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden; margin-bottom: 3rem; }
	.meta-item { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.5rem; background-color: var(--color-bg); }
	.meta-label { font-family: var(--font); font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
	.meta-value { font-family: var(--font-body); font-size: 0.95rem; color: var(--color-text); font-weight: 500; }
	.project-content { display: flex; flex-direction: column; gap: 2rem; }
	.showcase-embed { position: relative; width: 100%; aspect-ratio: 16/10.4; border-radius: 12px; overflow: hidden; background: #0E0E10; }
	.showcase-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
	.embed-note { font-size: 0.8rem; color: var(--color-text-muted); margin-top: -1rem; }
	.embed-note a { color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 3px; }
	.embed-note a:hover { color: var(--color-text); }
	.project-description { font-size: 0.82rem; color: var(--color-text-secondary); line-height: 1.7; }
	.section-title { font-family: var(--font); font-size: 1.25rem; font-weight: 600; color: var(--color-text); margin-top: 1rem; margin-bottom: 1rem; }
	.project-description strong, .insight-list strong { color: var(--color-text); font-weight: 600; }
	.process-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
	.process-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.25rem; border: 1px solid var(--color-border); border-radius: 8px; }
	.process-label { font-family: var(--font); font-size: 0.7rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
	.process-card p { font-size: 0.82rem; color: var(--color-text-secondary); line-height: 1.6; margin: 0; }
	.insight-list { display: flex; flex-direction: column; gap: 0.75rem; padding-left: 1.1rem; margin: 0; }
	.insight-list li { font-size: 0.82rem; color: var(--color-text-secondary); line-height: 1.7; }
	@media (max-width: 768px) {
		.project-info h1 { font-size: 1.75rem; }
		.meta-grid { grid-template-columns: repeat(2, 1fr); }
		.process-grid { grid-template-columns: 1fr; }
	}
</style>
